# Fast compile-only check for the F6 SM90 large-M block kernels selected by
# the Llama B128/decode and M960/prefill geometry. It compiles the same device
# kernel definitions as the full library while avoiding its full shape/variant
# template-instantiation matrix. The resulting object is not a runtime library.
genrule(
    name = "qvq_p32_sm90_compile_check",
    srcs = [
        "qvq_p32_abi.h",
        "qvq_p32_cuda.cu",
        "qvq_p32_internal.h",
        "qvq_p32_large_m2_kernel.cuh",
        "qvq_p32_large_m2_launch.cuh",
        "qvq_p32_large_m_grid_kernel.cuh",
        "qvq_p32_large_m_grid_launch.cuh",
    ],
    outs = ["objects/dev_sm90/qvq_p32_compile_check.o"],
    cmd = """
set -eu
cuda_home="$${CUDA_HOME:-/usr/local/cuda}"
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then cuda_home=/usr/local/cuda-13.3; fi
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then
  echo "nvcc not found; set CUDA_HOME to a CUDA toolkit containing nvcc" >&2
  exit 1
fi
"$${cuda_home}/bin/nvcc" \\
  -std=c++17 -O3 -lineinfo -cudart=shared -Xcompiler=-fPIC \\
  --objdir-as-tempdir --split-compile=8 \\
  -DQVQ_P32_SM90_COMPILE_CHECK_ONLY=1 \\
  -diag-suppress=177 \\
  -gencode arch=compute_90,code=sm_90 \\
  -I$$(dirname $(location qvq_p32_abi.h)) \\
  -c -o "$@" $(location qvq_p32_cuda.cu)
""",
    tags = ["manual"],
)

genrule(
    name = "qvq_p32_rank8_object",
    srcs = [
        "qvq_p32_abi.h",
        "qvq_p32_internal.h",
        "qvq_p32_rank8.cu",
    ],
    outs = ["objects/rank8/qvq_p32_rank8.o"],
    cmd = """
set -eu
cuda_home="$${CUDA_HOME:-/usr/local/cuda}"
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then cuda_home=/usr/local/cuda-13.3; fi
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then
  echo "nvcc not found; set CUDA_HOME to a CUDA toolkit containing nvcc" >&2
  exit 1
fi
"$${cuda_home}/bin/nvcc" \
  -std=c++17 -O3 -lineinfo -cudart=shared -Xcompiler=-fPIC \
  --objdir-as-tempdir \
  -gencode arch=compute_90,code=sm_90 \
  -I$$(dirname $(location qvq_p32_abi.h)) \
  -c -o "$@" $(location qvq_p32_rank8.cu)
""",
    tags = ["manual"],
)

genrule(
    name = "qvq_p32_runtime_object",
    srcs = [
        "qvq_p32_abi.h",
        "qvq_p32_internal.h",
        "qvq_p32_runtime.cu",
    ],
    outs = ["objects/runtime/qvq_p32_runtime.o"],
    cmd = """
set -eu
cuda_home="$${CUDA_HOME:-/usr/local/cuda}"
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then cuda_home=/usr/local/cuda-13.3; fi
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then
  echo "nvcc not found; set CUDA_HOME to a CUDA toolkit containing nvcc" >&2
  exit 1
fi
"$${cuda_home}/bin/nvcc" \
  -std=c++17 -O2 -cudart=shared -Xcompiler=-fPIC \
  --objdir-as-tempdir \
  -gencode arch=compute_90,code=sm_90 \
  -I$$(dirname $(location qvq_p32_abi.h)) \
  -c -o "$@" $(location qvq_p32_runtime.cu)
""",
    tags = ["manual"],
)

# QvQ owns the framework-neutral P32 runtime. Framework repositories consume
# this target and provide only their graph/compiler adapters.
genrule(
    name = "libqvq_p32",
    srcs = [
        ":qvq_p32_core_object",
        ":qvq_p32_rank8_object",
        ":qvq_p32_runtime_object",
    ],
    outs = ["libqvq_p32.so"],
    cmd = """
set -eu
cuda_home="$${CUDA_HOME:-/usr/local/cuda}"
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then cuda_home=/usr/local/cuda-13.3; fi
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then
  echo "nvcc not found; set CUDA_HOME to a CUDA toolkit containing nvcc" >&2
  exit 1
fi
"$${cuda_home}/bin/nvcc" -shared -cudart=shared \
  -o "$@" \
  $(locations :qvq_p32_core_object) \
  $(location :qvq_p32_rank8_object) \
  $(location :qvq_p32_runtime_object)
""",
    tags = ["manual"],
)

genrule(
    name = "runtime_smoke_bin",
    srcs = [
        ":libqvq_p32",
        "qvq_p32_abi.h",
        "qvq_p32_runtime_smoke.cu",
    ],
    outs = ["qvq_p32_runtime_smoke"],
    cmd = """
set -eu
cuda_home="$${CUDA_HOME:-/usr/local/cuda}"
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then cuda_home=/usr/local/cuda-13.3; fi
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then
  echo "nvcc not found; set CUDA_HOME to a CUDA toolkit containing nvcc" >&2
  exit 1
fi
"$${cuda_home}/bin/nvcc" \
  -std=c++17 -O2 -cudart=shared \
  -gencode arch=compute_90,code=sm_90 \
  -I$$(dirname $(location qvq_p32_abi.h)) \
  -L$$(dirname $(location :libqvq_p32)) -lqvq_p32 \
  -Xlinker=-rpath -Xlinker='$$ORIGIN' \
  -o "$@" $(location qvq_p32_runtime_smoke.cu)
""",
    executable = True,
    tags = ["manual"],
)

sh_test(
    name = "runtime_smoke",
    srcs = ["run_runtime_smoke.sh"],
    args = ["$(location :runtime_smoke_bin)"],
    data = [
        ":libqvq_p32",
        ":runtime_smoke_bin",
    ],
    tags = ["manual"],
)
