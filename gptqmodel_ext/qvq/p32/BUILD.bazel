# The production P32 template matrix is split by kernel family, transition
# width and workload kind. Large-M2 keeps stages 1/2 together and splits
# stages 3/4; large-M grid keeps low/high buckets. Device kernels and launchers
# are separate inputs so editing one path leaves the other workload
# shards eligible for action-cache reuse.
p32_shards()

genrule(
    name = "qvq_p32_dispatch_object",
    srcs = [
        "qvq_p32_abi.h",
        "qvq_p32_dispatch.cu",
    ],
    outs = ["objects/core/qvq_p32_dispatch.o"],
    cmd = """
set -eu
cuda_home="$${CUDA_HOME:-/usr/local/cuda}"
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then cuda_home=/usr/local/cuda-13.3; fi
if [ ! -x "$${cuda_home}/bin/nvcc" ]; then
  echo "nvcc not found; set CUDA_HOME to a CUDA toolkit containing nvcc" >&2
  exit 1
fi
"$${cuda_home}/bin/nvcc" \\
  -std=c++17 -O2 -cudart=shared -Xcompiler=-fPIC \\
  --objdir-as-tempdir \\
  -gencode arch=compute_90,code=sm_90 \\
  -I$$(dirname $(location qvq_p32_abi.h)) \\
  -c -o "$@" $(location qvq_p32_dispatch.cu)
""",
    tags = ["manual"],
)

filegroup(
    name = "qvq_p32_core_object",
    srcs = [
        ":qvq_p32_dispatch_object",
        ":qvq_p32_standard_scalar_bits4_object",
