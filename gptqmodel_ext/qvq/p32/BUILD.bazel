        ":qvq_p32_standard_block_bits7_object",
        ":qvq_p32_standard_large_m2_low_bits4_object",
        ":qvq_p32_standard_large_m2_low_bits5_object",
        ":qvq_p32_standard_large_m2_low_bits6_object",
        ":qvq_p32_standard_large_m2_low_bits7_object",
        ":qvq_p32_standard_large_m2_stage3_bits4_object",
        ":qvq_p32_standard_large_m2_stage3_bits5_object",
        ":qvq_p32_standard_large_m2_stage3_bits6_object",
        ":qvq_p32_standard_large_m2_stage3_bits7_object",
        ":qvq_p32_standard_large_m2_stage4_bits4_object",
        ":qvq_p32_standard_large_m2_stage4_bits5_object",
        ":qvq_p32_standard_large_m2_stage4_bits6_object",
        ":qvq_p32_standard_large_m2_stage4_bits7_object",
        ":qvq_p32_standard_large_m_grid_low_bits4_object",
        ":qvq_p32_standard_large_m_grid_low_bits5_object",
        ":qvq_p32_standard_large_m_grid_low_bits6_object",
        ":qvq_p32_standard_large_m_grid_low_bits7_object",
        ":qvq_p32_standard_large_m_grid_high_bits4_object",
        ":qvq_p32_standard_large_m_grid_high_bits5_object",
