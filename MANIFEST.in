include licenses/*
recursive-include gptqmodel/models/ports *.md *.txt *.json *.ttf *.model *.jinja LICENSE* *LICENSE *LICENSE.pdf NOTICE* ACKNOWLEDGEMENTS*
# Release inventories, original tokenizer samples and tests are checkout-only.
prune gptqmodel/models/ports/*/fixtures
prune gptqmodel/models/ports/*/tests
recursive-exclude gptqmodel/models/ports *.gz *.zst central_fixture_proposals.json module_plan_fixture.json
recursive-exclude gptqmodel/models/ports checkpoint_ownership.json checkpoint_contracts.json checkpoint_inventory.json
recursive-exclude gptqmodel/models/ports checkpoint-schema.json checkpoint_metadata.json upstream_config.json
recursive-exclude gptqmodel/models/ports registry_plan.json module_plan_case.json
recursive-exclude gptqmodel/models/ports tokenizer_contracts.json tokenizer_oracle.json tokenizer_reference.json
exclude gptqmodel/models/ports/nemotron_omni/source_config.json
recursive-exclude gptqmodel/models/ports/minicpm_o checkpoint-*-config.json checkpoint-*-checkpoint-layout.json
include gptqmodel_ext/pack_block_cpu.cpp
include gptqmodel_ext/floatx_cpu.cpp
include gptqmodel_ext/marlin/generate_kernels.py
include gptqmodel_ext/machete/generate.py
recursive-exclude gptqmodel_ext __pycache__ *.pyc
prune gptqmodel_ext/machete/generated
prune gptqmodel_ext/ttbfp/tests
prune gptqmodel_ext/ttbfp/tools
prune tests/
prune format/
