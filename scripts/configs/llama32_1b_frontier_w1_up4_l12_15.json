{
  "bits": 2,
  "format": "qvq_v2b2_p32",
  "bank_count": 2,
  "rounding": "yaqa",
  "yaqa": {
    "seed": 0,
    "regularization": 0.15
  },
  "device": "cuda:0",
  "offload_to_disk": false,
  "dynamic": {
    "+:^model\\.layers\\.[0-9]+\\.(self_attn.q_proj|self_attn.k_proj)$": {
      "bits": 2.5
    },
    "+:^model\\.layers\\.[0-9]+\\.(self_attn.v_proj|self_attn.o_proj)$": {
      "bits": 3.5
    },
    "+:^model\\.layers\\.[0-9]+\\.(mlp.gate_proj|mlp.up_proj|mlp.down_proj)$": {
      "bits": 3.0
    },
    "+:^model\\.layers\\.(12|13|14|15)\\.(mlp.up_proj)$": {
      "bits": 4,
      "format": "qvq"
    }
  }
}
